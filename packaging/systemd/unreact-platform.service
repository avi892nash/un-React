[Unit]
Description=unreact-platform — Tutorial platform static server
Documentation=https://github.com/avi892nash/un-React
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unreact-platform
Group=unreact-platform
WorkingDirectory=/opt/unreact-platform
EnvironmentFile=/etc/unreact-platform/unreact-platform.env
ExecStart=/usr/bin/node /opt/unreact-platform/server.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

# Hardening.
# NOTE: MemoryDenyWriteExecute is intentionally NOT enabled — it crashes
# Node with SIGTRAP because V8's JIT must allocate writable+executable
# memory pages for compiled JavaScript. Every other directive here is
# compatible with Node and worth keeping.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/unreact-platform
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
