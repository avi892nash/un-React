[Unit]
Description=unreact-platform — Auto-update poll timer
Documentation=https://github.com/avi892nash/un-React
Wants=unreact-platform-update.service

[Timer]
# Check the GitHub Releases API for a new unreact-platform version every
# 5 min, with up to 1 min of randomized jitter so many clients don't all
# hit the API at the same moment. First check happens 2 min after boot.
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=1min
Persistent=true
Unit=unreact-platform-update.service

[Install]
WantedBy=timers.target
