#!/bin/bash
# unreact-platform auto-updater.
#
# Compares the locally-installed release tag against the latest GitHub
# release and applies the new .deb if they differ. Runs as root via the
# systemd oneshot unit unreact-platform-update.service.
#
# Design notes
# ------------
# We deliberately do NOT use api.github.com — its unauthenticated rate
# limit is 60 req/hr per IP, and on CGNAT'd home networks (very common on
# Raspberry Pi installs) that 60/hr quota is shared across every device
# behind the same public IP. A few neighbours and the limit is gone; the
# updater starts getting HTTP 403 for hours at a stretch even though our
# own polling is well under the limit.
#
# Instead we use the *web* endpoint /<repo>/releases/latest, which
# 302-redirects to /<repo>/releases/tag/<tag>. Following the redirect tells
# us the latest tag with no JSON parsing, no API rate limit, no Node.js
# dependency, no auth token. The .deb URL is then constructed from a
# stable convention:
#
#     https://github.com/<repo>/releases/download/<tag>/unreact-platform.deb
#
# which build-deb.sh has guaranteed for every release since v1.0.0.

set -e

REPO="avi892nash/un-React"
INSTALLED_TAG_FILE="/var/lib/unreact-platform/installed-tag"

log()  { printf '[unreact-platform-update] %s\n' "$*"; }
fail() { printf '[unreact-platform-update] ERROR: %s\n' "$*" >&2; exit 1; }

# Don't fight another apt/dpkg process; skip and try next poll.
if lsof /var/lib/dpkg/lock-frontend &>/dev/null 2>&1; then
  log "dpkg locked by another process, skipping (will retry next poll)"
  exit 0
fi

# A descriptive User-Agent so anyone tailing GitHub's access logs can
# recognise this updater. Required by api.github.com (not strictly by the
# web edge we use here, but cheap to send and good hygiene).
UA="unreact-platform-update (https://github.com/${REPO})"

LATEST_URL="https://github.com/${REPO}/releases/latest"

TMPFILE=""
trap 'rm -f "$TMPFILE"' EXIT

# ---------------------------------------------------------------------------
# Resolve the latest tag via redirect.
#
# `curl -sI -L` follows redirects and prints headers from every hop. The
# final Location header (or the final effective URL via -w) points at
# .../releases/tag/<tag>. We use -w to skip any header-parsing fragility:
# curl gives us the final URL directly.
# ---------------------------------------------------------------------------
EFFECTIVE_URL=$(curl -sS -L -o /dev/null -A "$UA" -w "%{url_effective}" "$LATEST_URL" 2>/dev/null) \
  || { log "GitHub unreachable, skipping"; exit 0; }

# Sanity: must look like .../releases/tag/<something>
if ! [[ "$EFFECTIVE_URL" =~ /releases/tag/([^/?#]+) ]]; then
  log "Unexpected response from $LATEST_URL — got '$EFFECTIVE_URL'. No releases yet? Skipping."
  exit 0
fi
TAG="${BASH_REMATCH[1]}"

# ---------------------------------------------------------------------------
# Compare with what's installed.
# ---------------------------------------------------------------------------
LOCAL_TAG=$(cat "$INSTALLED_TAG_FILE" 2>/dev/null || echo "")

if [ "$LOCAL_TAG" = "$TAG" ]; then
  log "Up to date ($TAG)"
  exit 0
fi

log "Update available: ${LOCAL_TAG:-none} → $TAG"

# ---------------------------------------------------------------------------
# Download the .deb. URL is stable thanks to build-deb.sh always normalising
# the artifact filename to unreact-platform.deb regardless of version.
# ---------------------------------------------------------------------------
DOWNLOAD_URL="https://github.com/${REPO}/releases/download/${TAG}/unreact-platform.deb"

TMPFILE=$(mktemp /tmp/unreact-platform-XXXXXX.deb)

log "Downloading $DOWNLOAD_URL"
curl -fsSL -A "$UA" "$DOWNLOAD_URL" -o "$TMPFILE" \
  || fail "download failed (HTTP error or network). URL was $DOWNLOAD_URL"

# ---------------------------------------------------------------------------
# Install. apt knows how to handle a local .deb path.
# ---------------------------------------------------------------------------
log "Installing $TAG..."
apt install -y "$TMPFILE" \
  || fail "apt install failed (see apt output above)"

mkdir -p "$(dirname "$INSTALLED_TAG_FILE")"
echo "$TAG" > "$INSTALLED_TAG_FILE"

log "Successfully updated to $TAG"
