# unreact-platform environment variables — edit as needed, then:
#   sudo systemctl restart unreact-platform

# TCP port the Node static server binds to.
PORT=3000

# Bind address. 0.0.0.0 = all interfaces; 127.0.0.1 = localhost only.
HOSTNAME=0.0.0.0

# Node environment. Leave as 'production' unless debugging.
NODE_ENV=production
